APP_NAME=Kisan Dost API
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
DEFAULT_LANGUAGE=ur
FALLBACK_LANGUAGE=en
MAX_AUDIO_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=30

# Hosted LLM configuration (OpenAI-compatible API)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen-2.5-32b-instruct
LLM_TIMEOUT_SECONDS=30

# Hosted STT configuration (OpenAI-compatible Whisper API)
STT_API_KEY=your_stt_api_key_here
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_SECONDS=30
STT_MAX_AUDIO_SIZE_MB=25
